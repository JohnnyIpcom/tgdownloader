telegram:
  app:
    id: 0000000
    hash: "000000000000000000000000000000000000000000000"
  phone: "+389999999999"
  password: "password"

  mtproto:
    public_keys:
      - "public_key_test.pem"
      - "public_key_prod.pem"

  clock:
    ntp:
      host: "pool.ntp.org"

  session:
    path: "session.json"

  storage:
    path: "storage.db"

  rate:
    limit: 100ms
    burst: 3

  flood_wait:
    log: true

  download:
    allow_cdn: true

  network:
    resolver: "plain" # plain, env, socks5, mtproxy
    # dc: 2
    # test_dc: false
    # dial_timeout: 35s
    # prefer_ipv6: false
    # no_obfuscated: false
    # proxy:
    #   address: "127.0.0.1:1080"
    #   user: ""
    #   password: ""
    # mtproxy:
    #   address: "127.0.0.1:443"
    #   secret: "hex-encoded-secret"
    #   network: "tcp"

  updates:
    disable: false

  connection:
    log_on_dead: true
    # migration_timeout: 15s
    # reconnect:
    #   initial_interval: 500ms
    #   max_interval: 30s
    #   max_elapsed_time: 0s
    #   multiplier: 1.5
    #   randomization_factor: 0.5

downloader:
  type: "local" # local, dropbox
  retry:
    count: 3
    delay: 400ms
  dir:
    output: "./downloads"

service:
  password: 'password'
  downloader_id: "111111111111"

prompt:
  history:
    enabled: true
    max_entries: 1000
    # path: "/absolute/path/to/.tgdownloader_history"

logger:
  outputPaths:
    #- "stderr"
    - "/var/log/tgdownloader.log"
